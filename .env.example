# Copy this file to .env and fill in what you need. Never put real keys in THIS file —
# it is shared on GitHub. Real values go in .env, which is never uploaded.
# With nothing filled in, the site runs locally with a built-in development
# database and saves photos in ./data — perfect for trying things out.

# ── Database (Neon) ────────────────────────────────────────────────────────
# Neon dashboard → your project → Connect → copy the connection string.
# Leave empty to use the local development database instead.
# DATABASE_URL=postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# ── Photos (Cloudflare R2) ─────────────────────────────────────────────────
# All five are needed. Leave them all empty to store photos locally.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=texas-wings-photos
# R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev

# ── Server ─────────────────────────────────────────────────────────────────
# PORT=3000
# NODE_ENV=production        (Render sets this automatically from render.yaml)
# TRUST_PROXY=1              (set when running behind a proxy; Render does this for you)
# SESSION_SECRET=            (long random text; Render generates one automatically)
# SITE_URL=https://www.example.com   (can also be set in Admin → Website settings)
# DATA_DIR=./data            (local development database + photos)

# ── Optional: email alerts for new contact-form messages ───────────────────
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=you@example.com
# SMTP_PASS=app-password
# SMTP_FROM="Texas Wings & Tails <you@example.com>"
