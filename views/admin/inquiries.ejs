<%- include('top') %>
<div class="page-head">
  <div>
    <h1>Messages</h1>
    <p class="muted">Messages sent through the contact form on your website.</p>
  </div>
</div>
<% if (!items.length) { %>
<div class="card empty"><%- icon('inbox', 'empty-icon') %><h2>No messages yet</h2><p class="muted">When someone uses the contact form, their message will appear here.</p></div>
<% } else { %>
<ul class="list card list-flush">
  <% for (const q of items) { %>
  <li><a class="list-row <%= q.is_read ? '' : 'unread' %>" href="/admin/inquiries/<%= q.id %>">
    <span class="dot" aria-hidden="true"></span>
    <span class="grow"><strong><%= q.name %></strong><% if (!q.is_read) { %><span class="sr-only"> (new)</span><% } %>
      <small><%= q.interest ? q.interest.split(' — ')[0] + ' · ' : '' %><%= excerpt(q.message, 90) %></small></span>
    <small class="muted nowrap"><%= formatDate(q.created_at, { month: 'short', day: 'numeric', year: 'numeric' }) %></small>
  </a></li>
  <% } %>
</ul>
<% } %>
<%- include('bottom') %>
