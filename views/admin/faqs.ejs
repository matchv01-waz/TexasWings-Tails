<%- include('top') %>
<% const hidden = faqs.filter(f => !f.published || !f.answer).length; %>
<div class="page-head">
  <div>
    <h1>FAQs</h1>
    <p class="muted">Questions only appear on the website once they have an answer and are set to “Show”.</p>
  </div>
  <a class="btn btn-primary" href="/admin/faqs/new"><%- icon('plus') %> Add a question</a>
</div>
<% if (hidden) { %>
<div class="notice"><%- icon('help') %><p><strong><%= hidden %> question<%= hidden === 1 ? ' is' : 's are' %> waiting for your answer.</strong> Write answers in your own words — especially about payment, DNA testing, weaning, shipping and visits, so visitors get accurate information.</p></div>
<% } %>
<ul class="sortable-list" data-sortable data-order-url="/admin/faqs/order">
  <% faqs.forEach((f, i) => { const live = f.published && f.answer; %>
  <li class="sort-row" draggable="true" data-id="<%= f.id %>">
    <span class="drag-handle" aria-hidden="true"><%- icon('grip') %></span>
    <a class="sort-main" href="/admin/faqs/<%= f.id %>">
      <strong><%= f.question %></strong>
      <small class="muted"><%= f.answer ? excerpt(f.answer, 110) : 'No answer yet' %></small>
    </a>
    <span class="pill <%= live ? 'pill-green' : '' %>"><%= live ? 'Shown' : (f.answer ? 'Hidden' : 'Needs answer') %></span>
    <div class="row-actions">
      <form method="post" action="/admin/faqs/order"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="id" value="<%= f.id %>"><input type="hidden" name="dir" value="up">
        <button class="icon-btn" type="submit" aria-label="Move up" <%- i === 0 ? 'disabled' : '' %>><%- icon('up') %></button></form>
      <form method="post" action="/admin/faqs/order"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="id" value="<%= f.id %>"><input type="hidden" name="dir" value="down">
        <button class="icon-btn" type="submit" aria-label="Move down" <%- i === faqs.length - 1 ? 'disabled' : '' %>><%- icon('down') %></button></form>
      <a class="btn btn-outline btn-sm" href="/admin/faqs/<%= f.id %>"><%- icon('edit') %> <%= f.answer ? 'Edit' : 'Answer' %></a>
    </div>
  </li>
  <% }) %>
</ul>
<%- include('bottom') %>
